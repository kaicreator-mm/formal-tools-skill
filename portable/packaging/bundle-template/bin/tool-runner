#!/bin/bash
# tool-runner — unified runner for the formal-tools portable bundle (Debian 13 x86_64).
# Commands:
#   list                     list tools with version/kind
#   doctor [id|all]          environment + dependency self-check
#   verify <id|all>          real-execution verification (positive/negative cases), writes receipts
#   run <id> [args...]       run a tool entry point
#   py <script> [args...]    run a script with the bundled Python 3.13 runtime
#   node <script> [args...]  run a script with the bundled Node.js 22 runtime
#   java [args...]           run with the bundled Java 21 JRE
#   version <id>             recorded + probed version output
set -uo pipefail

FT_ROOT="$(cd "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# Physical (symlink-resolved) bundle root: containment checks compare physical
# paths so a symlinked deployment cannot smuggle paths outside the bundle.
FT_ROOT_P="$(cd -P -- "$FT_ROOT" 2>/dev/null && pwd -P)" || FT_ROOT_P="$FT_ROOT"
FT_EV="${FT_EVIDENCE_DIR:-$FT_ROOT/evidence}"
FT_TMP="$(mktemp -d /tmp/ft-XXXXXX)"
export FT_TMP
trap 'rm -rf "$FT_TMP"' EXIT
mkdir -p "$FT_EV"

# ---- python runtime env (shared) -------------------------------------------
py_env() {
  export PYTHONHOME="$FT_ROOT/runtimes/python313"
  export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
  export MPLCONFIGDIR="$FT_TMP/mpl"
  # shipped private libffi (debian:13 base image lacks it) + grammar cache for tree-sitter
  export LD_LIBRARY_PATH="$FT_ROOT/runtimes/python313/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  # tree-sitter-language pack takes a lock inside its cache dir -> bundle mount is RO;
  # copy the tiny shipped cache to a writable location per invocation
  if [ -d "$FT_ROOT/runtimes/py-cache" ]; then
    rm -rf "$FT_TMP/py-cache"
    cp -a "$FT_ROOT/runtimes/py-cache" "$FT_TMP/py-cache" 2>/dev/null || true
    export XDG_CACHE_HOME="$FT_TMP"
  else
    export XDG_CACHE_HOME="$FT_ROOT/runtimes/py-cache"
  fi
  # pytensor/pymc: no system compiler in minimal runtime -> pure-python mode
  export PYTENSOR_FLAGS="${PYTENSOR_FLAGS:-cxx=,compiledir=$FT_TMP/pytensor,base_compiledir=$FT_TMP/pytensor}"
  [ -d "$FT_TMP/mpl" ] || mkdir -p "$FT_TMP/mpl"
}

# A tool ID must be a single safe path component before it is ever used to
# build, source, execute, or write a path: [A-Za-z0-9._-]+ without a leading
# dot. This rejects traversal (../..), separators, absolute paths, and
# dot-segments up front — no filesystem path is constructed for unsafe IDs.
ft_safe_id() {
  case "$1" in
    ''|.*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# Resolve a bundle file to its physical path and require it to stay inside the
# given physical directory prefix (symlink containment for sourced/executed
# bundle content). Primary resolver is readlink -f (GNU and busybox both
# support it; busybox realpath does NOT support -e/--). Fallback resolves the
# containing directory with pure shell and walks a final symlink manually,
# failing closed on unresolved chains.
ft_path_under() { # file prefix -> rc
  local r
  r=$(readlink -f "$1" 2>/dev/null) || true
  if [ -z "$r" ]; then
    local d b t hop=0
    d=$(cd -- "$(dirname -- "$1")" 2>/dev/null && pwd -P) || return 1
    b=$(basename -- "$1")
    r="$d/$b"
    while [ -L "$r" ] && [ "$hop" -lt 10 ]; do
      t=$(readlink "$r") || return 1
      case "$t" in
        /*) r="$t" ;;
        *) r="$d/$t" ;;
      esac
      d=$(cd -- "$(dirname -- "$r")" 2>/dev/null && pwd -P) || return 1
      r="$d/$(basename -- "$r")"
      hop=$((hop + 1))
    done
    [ -L "$r" ] && return 1 # unresolved symlink chain: fail closed
  fi
  [ -n "$r" ] || return 1
  case "$r" in
    "$2"*) return 0 ;;
  esac
  return 1
}

tool_meta() { # id -> sources meta.sh into env
  if ! ft_safe_id "$1"; then
    echo "invalid tool id: $1 (must be a single [A-Za-z0-9._-] component without leading dot)" >&2
    return 2
  fi
  local m="$FT_ROOT/tools/$1/meta.sh"
  [ -f "$m" ] || { echo "unknown tool: $1 (no meta)" >&2; return 1; }
  # Symlink containment: the physical meta.sh must live inside the bundle's
  # tools/<id>/ directory; refuse sourced content that resolves outside.
  if ! ft_path_under "$m" "$FT_ROOT_P/tools/$1/"; then
    echo "invalid tool location: $1 (meta.sh resolves outside tools/$1)" >&2
    return 2
  fi
  # Prevent inherited/stale environment keys from masking broken bundle metadata.
  # Historical TOOL_TOOL_ID was a packaging bug, never a valid identity alias.
  unset TOOL_ID TOOL_VERSION TOOL_KIND TOOL_MAIN_BIN TOOL_GLIBC_MAX TOOL_ELF_ARCH TOOL_VERSION_OUTPUT UNAVAILABLE
  # shellcheck disable=SC1090
  . "$m" || return 1
  if [ "${TOOL_ID:-}" != "$1" ] || [ -z "${TOOL_VERSION:-}" ] || [ -z "${TOOL_KIND:-}" ]; then
    echo "invalid tool metadata: $1 (TOOL_ID/version/kind missing or mismatched)" >&2
    return 1
  fi
}

list_ids() { for f in "$FT_ROOT"/tools/*/meta.sh; do [ -f "$f" ] && basename "$(dirname "$f")"; done | sort; }

trow() { # verify TSV row: id phase exit duration_ms matched exit_ok label
  ft_safe_id "$1" || { echo "bad receipt id: $1" >&2; return 2; }
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$7" >> "$FT_EV/verify-$1.tsv"
}

expand_arg() { # expand $BUNDLE/$TOOL_DIR/$FT_TMP, normalize bare tests/ paths to the bundle
  local a="$1"
  a="${a//\$BUNDLE/$FT_ROOT}"; a="${a//\$TOOL_DIR/$FT_ROOT/tools/$VID}"; a="${a//\$FT_TMP/$FT_TMP}"
  case "$a" in tests/*) a="$FT_ROOT/$a" ;; esac
  printf '%s' "$a"
}

# ---- verify ----------------------------------------------------------------
run_case() { # id phase via args_string exit_ok_list regex label
  local id="$1" phase="$2" via="$3" args_s="$4" ok_exits="$5" re="$6" label="$7"
  local -a cmd=() args=()
  case "$via" in
    run)  cmd=("$FT_ROOT/bin/tool-runner" run "$id") ;;
    py)   py_env; cmd=("$FT_ROOT/runtimes/python313/bin/python3.13" -s) ;;
    node) cmd=("$FT_ROOT/runtimes/node22/bin/node") ;;
    java) export JAVA_HOME="$FT_ROOT/runtimes/java21"; export PATH="$JAVA_HOME/bin:$PATH"; cmd=(java) ;;
    sh)   cmd=(sh -c "$(expand_arg "$args_s")") ;;
    *)    echo "bad via: $via" >&2; return 2 ;;
  esac
  if [ "$via" = sh ]; then
    : # command string already assembled
  else
    # expand bundle vars in the raw string first (set -u would kill bare $BUNDLE inside eval),
    # then eval-split so quoted args (e.g. --prop "P>=0.1 [F done]") survive; per-token pass
    # still normalizes bare tests/ paths (idempotent for already-expanded values)
    local ex; ex=$(expand_arg "$args_s")
    eval "args=($ex)" || return 2
    local t
    for t in ${args[@]+"${args[@]}"}; do cmd+=("$(expand_arg "$t")"); done
  fi
  local t0 te rc out="$FT_EV/verify-$id.$phase.log"
  t0=$(date +%s%3N)
  cd "$FT_TMP" || cd /tmp
  timeout -k 10 "${EXPECT_TIMEOUT:-120}" "${cmd[@]}" >"$out" 2>&1
  rc=$?  # capture the actual tool/timeout status BEFORE any cleanup cd
  cd - >/dev/null 2>&1 || true
  te=$(( $(date +%s%3N) - t0 ))
  # anchor line so tools with empty success output can still be judged
  printf '\nPHASE_DONE phase=%s rc=%s\n' "$phase" "$rc" >> "$out"
  local matched=0 exit_ok=0
  grep -Eq "$re" "$out" && matched=1
  if [ "$ok_exits" = "*" ]; then
    exit_ok=1   # exit code not judged (output semantics decide)
  else
    local e
    for e in $ok_exits; do [ "$rc" = "$e" ] && exit_ok=1; done
  fi
  trow "$id" "$phase" "$rc" "$te" "$matched" "$exit_ok" "$label"
  echo "   $id/$phase: exit=$rc dur=${te}ms matched=$matched exit_ok=$exit_ok label=$label (log: $out)"
  [ "$matched" = 1 ] && [ "$exit_ok" = 1 ]
}

verify_one() {
  local id="$1"
  tool_meta "$id" || return 2
  local ef="$FT_ROOT/tests/$id/expect.sh"
  # Reset stale TSV data and bind all verdicts to the corrected exit recorder.
  printf 'runner_schema\tformal-tools/portable-verify/0.2\n' > "$FT_EV/verify-$id.tsv"
  if [ ! -f "$ef" ] || [ ! -x "$FT_ROOT/tools/$id/run" ]; then
    echo "verify: $id SKIP (no expect.sh or no run shim — tool unavailable)"
    printf 'verdict\tSKIP\n' >> "$FT_EV/verify-$id.tsv"
    return 1 # no executed cases => never PASS at verify-all
  fi
  # Symlink containment: a sourced expect.sh must physically live in tests/<id>/.
  if ! ft_path_under "$ef" "$FT_ROOT_P/tests/$id/"; then
    echo "verify: $id FAIL (expect.sh resolves outside tests/$id)" >&2
    printf 'verdict\tFAIL\n' >> "$FT_EV/verify-$id.tsv"
    return 1
  fi
  VID="$id"
  # isolate judgment contracts: expect vars leak across tools when verifying many
  # tools in one process (single-container deployments)
  unset EXPECT_TIMEOUT EXPECT_SETUP_VIA EXPECT_SETUP_ARGS \
        EXPECT_POS_VIA EXPECT_POS_ARGS EXPECT_POS_EXIT EXPECT_POS_REGEX EXPECT_POS_LABEL \
        EXPECT_NEG_VIA EXPECT_NEG_ARGS EXPECT_NEG_EXIT EXPECT_NEG_REGEX EXPECT_NEG_LABEL \
        EXPECT_ERR_VIA EXPECT_ERR_ARGS EXPECT_ERR_EXIT EXPECT_ERR_REGEX EXPECT_ERR_LABEL
  # shellcheck disable=SC1090
  . "$ef"
  : "${EXPECT_TIMEOUT:=120}"
  # optional setup phase (not judged)
  if [ -n "${EXPECT_SETUP_VIA:-}" ]; then
    run_case "$id" setup "$EXPECT_SETUP_VIA" "${EXPECT_SETUP_ARGS:-}" "0" "." "SETUP" || {
      printf 'verdict\tFAIL\n' >> "$FT_EV/verify-$id.tsv"
      return 1 # required setup failure invalidates downstream positive/negative cases
    }
  fi
  local ok=1
  if [ -n "${EXPECT_POS_REGEX:-}" ]; then
    run_case "$id" pos "${EXPECT_POS_VIA:-run}" "${EXPECT_POS_ARGS:-}" "${EXPECT_POS_EXIT:-0}" \
      "$EXPECT_POS_REGEX" "${EXPECT_POS_LABEL:-POS}" || ok=0
  fi
  if [ -n "${EXPECT_NEG_REGEX:-}" ]; then
    run_case "$id" neg "${EXPECT_NEG_VIA:-run}" "${EXPECT_NEG_ARGS:-}" "${EXPECT_NEG_EXIT:-*}" \
      "$EXPECT_NEG_REGEX" "${EXPECT_NEG_LABEL:-NEG}" || ok=0
  fi
  # optional invalid-input case (must fail loudly or report a typed error)
  if [ -n "${EXPECT_ERR_REGEX:-}" ]; then
    # invalid input: judged on the typed error text; exit code is tool-specific (default: any)
    run_case "$id" err "${EXPECT_ERR_VIA:-run}" "${EXPECT_ERR_ARGS:-}" "${EXPECT_ERR_EXIT:-*}" \
      "$EXPECT_ERR_REGEX" "${EXPECT_ERR_LABEL:-ERROR}" || ok=0
  fi
  if [ "$ok" = 1 ]; then printf 'verdict\tPASS\n' >> "$FT_EV/verify-$id.tsv"; else printf 'verdict\tFAIL\n' >> "$FT_EV/verify-$id.tsv"; fi
  [ "$ok" = 1 ]
}

# ---- doctor ----------------------------------------------------------------
doctor_one() {
  local id="$1" fails=0
  tool_meta "$id" || return 2
  echo "doctor: $id kind=${TOOL_KIND:-?} version=${TOOL_VERSION:-?}"
  if [ -n "${TOOL_MAIN_BIN:-}" ]; then
    if [ -f "$FT_ROOT/$TOOL_MAIN_BIN" ]; then
      echo "  binary: $TOOL_MAIN_BIN OK (glibc_max=${TOOL_GLIBC_MAX:-n/a})"
      # Match the tool's run shim: native solvers ship private shared libraries.
      # ldd without the tool lib path falsely flags ICU/libstdc++ as missing.
      local tool_lib="$FT_ROOT/tools/$id/lib"
      local miss ldd_out ldd_rc
      if [ -d "$tool_lib" ]; then
        # Symlink containment: a private lib dir must stay inside tools/<id>/.
        if ! ft_path_under "$tool_lib" "$FT_ROOT_P/tools/$id/"; then
          echo "  private lib dir escapes tools/$id FAIL"; fails=1
        else
          ldd_out=$(LD_LIBRARY_PATH="$tool_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ldd "$FT_ROOT/$TOOL_MAIN_BIN" 2>&1); ldd_rc=$?
        fi
      else
        ldd_out=$(ldd "$FT_ROOT/$TOOL_MAIN_BIN" 2>&1); ldd_rc=$?
      fi
      if [ -z "${ldd_out+x}" ]; then
        : # lib-dir containment already failed and marked the tool; no ldd judgment
      else
        # Fail closed: an ldd probe that did not run (nonzero rc) or produced
        # no dependency listing is never treated as "no missing libs".
        miss=$(printf '%s\n' "${ldd_out:-}" | grep -c "not found" || true)
        if [ "${miss:-0}" != 0 ]; then
          echo "  ldd missing libs: $miss FAIL"; fails=1
        elif [ "${ldd_rc:-1}" != 0 ] || [ -z "${ldd_out:-}" ]; then
          echo "  ldd probe FAILED (rc=${ldd_rc:-?}, no dependency listing)"; fails=1
        else
          echo "  ldd: no missing libs OK"
        fi
      fi
      [ "$(uname -m)" = x86_64 ] || { echo "  arch: host not x86_64 FAIL"; fails=1; }
    else
      echo "  binary MISSING: $TOOL_MAIN_BIN"; fails=1
    fi
  fi
  case "${TOOL_KIND:-}" in
    python*)
      py_env
      "$FT_ROOT/runtimes/python313/bin/python3.13" -s -c 'import sys; print("  python:", sys.version.split()[0], "OK")' || fails=1 ;;
    jar*|java*)
      "$FT_ROOT/runtimes/java21/bin/java" -version 2>&1 | head -1 | sed 's/^/  java /' || fails=1 ;;
  esac
  [ "$fails" = 0 ] && echo "  verdict: OK" || { echo "  verdict: FAIL"; return 1; }
}

# ---- dispatch --------------------------------------------------------------
cmd="${1:-help}"
case "$cmd" in
  list)
    printf '%-14s %-10s %-14s %s\n' ID KIND VERSION ENTRY
    for id in $(list_ids); do
      tool_meta "$id" 2>/dev/null || continue
      printf '%-14s %-10s %-14s %s\n' "$id" "${TOOL_KIND:-?}" "${TOOL_VERSION:-?}" "${TOOL_MAIN_BIN:-($TOOL_KIND)}"
    done
    ;;
  doctor)
    if [ -n "${2:-}" ] && [ "$2" != all ]; then doctor_one "$2"; else
      rc=0; for id in $(list_ids); do doctor_one "$id" || rc=1; done; exit $rc
    fi ;;
  verify)
    [ -n "${2:-}" ] || { echo "usage: tool-runner verify <id|all>" >&2; exit 2; }
    if [ "$2" = all ]; then
      : > "$FT_EV/verify-ALL.tsv"
      rc=0; for id in $(list_ids); do
        echo "verify: $id"; verify_one "$id" || rc=1
      done
      echo "verify-all verdict: $([ $rc = 0 ] && echo PASS || echo FAIL)"
      printf 'verdict_all\t%s\n' "$([ $rc = 0 ] && echo PASS || echo FAIL)" >> "$FT_EV/verify-ALL.tsv"
      exit $rc
    else verify_one "$2"; fi ;;
  run)
    id="${2:?usage: tool-runner run <id> [args...]}"; shift 2
    tool_meta "$id" || exit 2
    # Symlink containment: the executed run shim must physically live in tools/<id>/.
    if ! ft_path_under "$FT_ROOT/tools/$id/run" "$FT_ROOT_P/tools/$id/"; then
      echo "invalid tool entry: $id (run resolves outside tools/$id)" >&2
      exit 2
    fi
    exec "$FT_ROOT/tools/$id/run" "$@" ;;
  py)
    shift; py_env; exec "$FT_ROOT/runtimes/python313/bin/python3.13" -s "$@" ;;
  node)
    shift; exec "$FT_ROOT/runtimes/node22/bin/node" "$@" ;;
  java)
    shift; export JAVA_HOME="$FT_ROOT/runtimes/java21"; export PATH="$JAVA_HOME/bin:$PATH"; exec java "$@" ;;
  version)
    tool_meta "${2:?}" || exit 2
    echo "tool: ${TOOL_ID}"; echo "version: ${TOOL_VERSION}"; echo "probe: ${TOOL_VERSION_OUTPUT:-n/a}" ;;
  *)
    sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
